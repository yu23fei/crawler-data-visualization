@echo off
chcp 65001 >nul
title 招聘平台 - 一键启动
echo ============================================
echo   招聘大数据可视化分析平台 - 一键启动
echo ============================================
echo.
echo  本脚本会自动启动：后端 (5000) + 前端 (3000)
echo.

REM 启动后端（新窗口）
echo [1/2] 启动后端服务...
start "招聘平台-后端" cmd /k ""%~dp0启动后端.bat""

REM 稍等后端初始化
timeout /t 2 /nobreak >nul

REM 启动前端（新窗口）
echo [2/2] 启动前端服务...
start "招聘平台-前端" cmd /k ""%~dp0启动前端.bat""

echo.
echo ============================================
echo   启动完成！
echo   后端: http://localhost:5000
echo   前端: http://localhost:3000 （在浏览器打开这个）
echo ============================================
echo.
echo 提示：两个窗口分别对应后端和前端，关闭窗口即停止对应服务。
echo.
pause
