# 数据库配置 —— 生产环境必须设置强密码（至少8位，包含大小写字母和数字）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请在此处设置你的数据库密码（至少8位，字母数字组合）
DB_NAME=yingjie_spider

# JWT配置 —— 必须设置为至少32位的强随机密钥
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=请在此处设置至少32位的随机密钥
JWT_EXPIRATION=86400

# Flask配置
FLASK_ENV=production     # 生产环境必须设为 production
FLASK_DEBUG=0            # 生产环境必须设为 0

# Flask应用密钥（用于session等内置功能）
# 生成方式：python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=

# Redis配置（爬虫模块使用）
REDIS_PASSWORD=

# 限流配置（可选，使用默认值即可）
# LOGIN_RATE_LIMIT=5        # 登录接口每IP每分钟最大请求数
# RESET_RATE_LIMIT=3        # 密码重置接口每IP每分钟最大请求数
